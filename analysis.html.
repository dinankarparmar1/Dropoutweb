<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Stock Analysis | Dropout Traders</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:#07111f;
color:#fff;
}

.container{

max-width:1100px;

margin:auto;

padding:40px;

}

.hero{

background:#101d33;

padding:30px;

border-radius:20px;

border:1px solid rgba(255,255,255,.08);

}

.signal{

display:inline-block;

padding:8px 18px;

border-radius:30px;

font-weight:700;

margin-bottom:20px;

}

.buy{background:#16a34a;}
.sell{background:#dc2626;}
.hold{background:#eab308;color:#111;}

.hero img{

width:100%;

border-radius:18px;

margin:25px 0;

}

.grid{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:20px;

margin:30px 0;

}

.box{

background:#16243d;

padding:25px;

border-radius:18px;

text-align:center;

}

.box h2{

font-size:28px;

margin-top:10px;

}

.desc{

line-height:1.8;

color:#cbd5e1;

font-size:17px;

}

.share{

margin-top:40px;

display:flex;

gap:15px;

flex-wrap:wrap;

}

.share button{

padding:14px 20px;

border:none;

border-radius:10px;

cursor:pointer;

font-weight:600;

}

@media(max-width:768px){

.grid{

grid-template-columns:1fr;

}

}

</style>

</head>

<body>

<div class="container">

<div class="hero">

<div id="signal"></div>

<h1 id="stock"></h1>

<h3 id="title"></h3>

<img id="image">

<div class="grid">

<div class="box">

Entry

<h2 id="entry"></h2>

</div>

<div class="box">

Target

<h2 id="target"></h2>

</div>

<div class="box">

Stop Loss

<h2 id="stoploss"></h2>

</div>

</div>

<div class="desc" id="description"></div>

<div class="share">

<button onclick="share()">📤 Share</button>

</div>

</div>

</div>

<script type="module">

import {db} from "./firebase.js";

import{
doc,
getDoc
}from "https://www.gstatic.com/firebasejs/12.17.0/firebase-firestore.js";

const id=new URLSearchParams(location.search).get("id");

const snap=await getDoc(doc(db,"dailyAnalysis",id));

const d=snap.data();

document.title=d.stock+" Analysis | Dropout Traders";

document.getElementById("stock").innerHTML=d.stock;

document.getElementById("title").innerHTML=d.title;

document.getElementById("entry").innerHTML=d.entry;

document.getElementById("target").innerHTML=d.target;

document.getElementById("stoploss").innerHTML=d.stoploss;

document.getElementById("description").innerHTML=d.description;

document.getElementById("image").src=d.image;

document.getElementById("signal").className="signal "+d.signal.toLowerCase();

document.getElementById("signal").innerHTML=d.signal;

window.share=()=>{

navigator.share({

title:d.title,

text:d.description,

url:location.href

});

};

</script>

</body>
</html>
